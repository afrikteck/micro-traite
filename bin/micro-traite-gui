#!/usr/bin/env python3
"""Micro Traité - interface GTK3 pour piloter une chaîne audio PipeWire.

Chaîne "broadcast" inspirée des micros studio (coupe-bas, corps, creux carton,
présence, clarté, sifflantes, air, compression 2 étages, limiteur).
Sortie : source virtuelle « Micro Traité » utilisable dans toutes les applis.

Usage :
    micro-traite-gui              # interface graphique
    micro-traite-gui --write-conf # écrit la conf sans interface (install)
"""

import json
import os
import subprocess
import sys
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

HOME = os.path.expanduser("~")
CONF_DIR = os.path.join(HOME, ".config", "pipewire", "pipewire.conf.d")
CONF_PATH = os.path.join(CONF_DIR, "micro-prepro.conf")
STATE_PATH = os.path.join(HOME, ".config", "micro-traite-gui.json")
RNNOISE_PLUGIN = "/usr/lib/ladspa/librnnoise_ladspa.so"
SC4M = "/usr/lib/ladspa/sc4m_1916.so"
HARDLIM = "/usr/lib/ladspa/hard_limiter_1413.so"

DEFAULTS = {
    "input": "",
    "noise": True, "vad": 50, "grace": 120,
    "eq": True, "hp_freq": 55,
    "corps": 1.5, "box": -2.5, "mud": -1.0,
    "pres": 3.5, "intel": 2.5, "sib": -1.5, "air": 1.5,
    "comp": True,
    "c1_thr": -22, "c1_ratio": 2.0, "c1_att": 20, "c1_rel": 250, "c1_makeup": 2.0,
    "c2_thr": -10, "c2_ratio": 4.0, "c2_makeup": 1.0,
    "limiter": True, "l_thr": -1.5,
}


def list_sources():
    """Liste les micros disponibles (node.name, description) via PipeWire."""
    try:
        out = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=5).stdout
        data = json.loads(out)
    except Exception:
        return []
    found = []
    for obj in data:
        props = obj.get("info", {}).get("props", {})
        if props.get("media.class") != "Audio/Source":
            continue
        name = props.get("node.name", "")
        if not name or name.startswith("micro-traite") or "monitor" in name:
            continue
        found.append((name, props.get("node.description", name)))
    return found


def load_state():
    s = dict(DEFAULTS)
    try:
        with open(STATE_PATH) as f:
            saved = json.load(f)
        s.update({k: v for k, v in saved.items() if k in DEFAULTS})
    except Exception:
        pass
    return s


def resolve_input(s, sources=None):
    sources = sources if sources is not None else list_sources()
    names = [n for n, _ in sources]
    if s.get("input") not in names:
        s["input"] = names[0] if names else ""
    return s["input"]


def build_conf(s):
    nodes, links, order = [], [], []

    if s["noise"]:
        nodes.append(
            '                    { type = ladspa name = rnnoise '
            f'plugin = "{RNNOISE_PLUGIN}" label = noise_suppressor_mono\n'
            '                      control = {\n'
            f'                        "VAD Threshold (%)" = {int(s["vad"])}.0\n'
            f'                        "VAD Grace Period (ms)" = {int(s["grace"])}.0\n'
            '                        "Retroactive VAD Grace (ms)" = 0.0\n'
            '                      } }'
        )
        order.append(("rnnoise", "Output", "Input"))

    if s["eq"]:
        def bq(name, label, freq, gain=None, q=0.9):
            extra = f' "Gain" = {gain:.2f}' if gain is not None else ""
            nodes.append(
                f'                    {{ type = builtin name = {name} label = {label} '
                f'control = {{ "Freq" = {float(freq):.1f} "Q" = {float(q):.3f}{extra} }} }}'
            )
        bq("hp", "bq_highpass", s["hp_freq"], q=0.707)
        bq("corps", "bq_lowshelf", 90.0, s["corps"], q=0.707)
        bq("box", "bq_peaking", 280.0, s["box"], q=1.0)
        bq("mud", "bq_peaking", 400.0, s["mud"], q=1.0)
        bq("pres", "bq_peaking", 2500.0, s["pres"], q=0.9)
        bq("intel", "bq_peaking", 5000.0, s["intel"], q=0.9)
        bq("sib", "bq_peaking", 7000.0, s["sib"], q=2.0)
        bq("air", "bq_highshelf", 12000.0, s["air"], q=0.707)
        order += [("hp", "Out", "In"), ("corps", "Out", "In"), ("box", "Out", "In"),
                  ("mud", "Out", "In"), ("pres", "Out", "In"), ("intel", "Out", "In"),
                  ("sib", "Out", "In"), ("air", "Out", "In")]

    if s["comp"]:
        def sc4m(name, thr, ratio, att, rel, makeup, knee, rms):
            nodes.append(
                f'                    {{ type = ladspa name = {name} plugin = "{SC4M}" label = sc4m\n'
                '                      control = {\n'
                f'                        "RMS/peak" = {rms}\n'
                f'                        "Attack time (ms)" = {att}.0\n'
                f'                        "Release time (ms)" = {rel}.0\n'
                f'                        "Threshold level (dB)" = {thr:.1f}\n'
                f'                        "Ratio (1:n)" = {ratio:.1f}\n'
                f'                        "Knee radius (dB)" = {knee}.0\n'
                f'                        "Makeup gain (dB)" = {makeup:.1f}\n'
                '                      } }'
            )
        sc4m("comp1", s["c1_thr"], s["c1_ratio"], int(s["c1_att"]), int(s["c1_rel"]), s["c1_makeup"], 6, 1.0)
        sc4m("comp2", s["c2_thr"], s["c2_ratio"], 5, 100, s["c2_makeup"], 3, 0.0)
        order += [("comp1", "Output", "Input"), ("comp2", "Output", "Input")]

    if s["limiter"]:
        nodes.append(
            '                    { type = ladspa name = limiter '
            f'plugin = "{HARDLIM}" label = hardLimiter '
            f'control = {{ "dB limit" = {s["l_thr"]:.1f} "Wet level" = 1.0 "Residue level" = 0.0 }} }}'
        )
        order.append(("limiter", "Output", "Input"))

    if not order:
        nodes.append(
            '                    { type = builtin name = pass label = bq_lowpass '
            'control = { "Freq" = 20000.0 "Q" = 0.7 } }'
        )
        order.append(("pass", "Out", "In"))

    for i in range(len(order) - 1):
        prev, out_port, _ = order[i]
        nxt, _, in_port = order[i + 1]
        links.append(f'                    {{ output = "{prev}:{out_port}" input = "{nxt}:{in_port}" }}')

    target = f'\n                node.target  = "{s["input"]}"' if s.get("input") else ""
    return f'''# Généré par micro-traite-gui - ne pas éditer à la main
context.modules = [
    {{ name = libpipewire-module-filter-chain
        flags = [ nofail ]
        args = {{
            node.description = "Micro Traité"
            media.name       = "Micro Traité"
            filter.graph = {{
                nodes = [
{chr(10).join(nodes)}
                ]
                links = [
{chr(10).join(links)}
                ]
            }}
            audio.channels = 1
            audio.position = [ MONO ]
            capture.props = {{
                node.name    = "capture.micro-traite"{target}
                node.passive = true
            }}
            playback.props = {{
                node.name    = "micro-traite"
                media.class  = Audio/Source
            }}
        }}
    }}
]
'''


def write_conf(s):
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(CONF_PATH, "w") as f:
        f.write(build_conf(s))
    with open(STATE_PATH, "w") as f:
        json.dump(s, f, indent=2)
    return CONF_PATH


class MicroTraiteApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Micro Traité")
        self.set_border_width(10)
        self.set_default_size(470, 680)
        self.set_resizable(False)

        self.s = load_state()
        self._sources = list_sources()
        resolve_input(self.s, self._sources)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(scroll)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll.add(outer)
        self._w = {}

        outer.pack_start(self._title("Micro d'entrée"), False, False, 0)
        self.combo = Gtk.ComboBoxText()
        for name, desc in self._sources:
            self.combo.append(name, desc)
        if self._sources:
            self.combo.set_active_id(self.s["input"])
        outer.pack_start(self.combo, False, False, 0)
        outer.pack_start(Gtk.Separator(), False, False, 0)

        self._check(outer, "noise", "Suppression du bruit (RNNoise)")
        self._slider(outer, "vad", "Voix (VAD)", 0, 99, 1, " %")
        self._slider(outer, "grace", "Maintien fin de mot", 0, 1000, 10, " ms")
        outer.pack_start(Gtk.Separator(), False, False, 0)

        self._check(outer, "eq", "Égaliseur")
        self._slider(outer, "hp_freq", "Coupe-bas", 40, 200, 5, " Hz")
        self._slider(outer, "corps", "Corps (grave)", -6, 6, 0.5, " dB")
        self._slider(outer, "box", "Creux « carton » (280 Hz)", -8, 4, 0.5, " dB")
        self._slider(outer, "mud", "Bas-médium (400 Hz)", -6, 4, 0.5, " dB")
        self._slider(outer, "pres", "Présence (2,5 kHz)", -4, 8, 0.5, " dB")
        self._slider(outer, "intel", "Clarté (5 kHz)", -4, 8, 0.5, " dB")
        self._slider(outer, "sib", "Sifflantes (7 kHz)", -8, 2, 0.5, " dB")
        self._slider(outer, "air", "Air (12 kHz)", -4, 6, 0.5, " dB")
        outer.pack_start(Gtk.Separator(), False, False, 0)

        self._check(outer, "comp", "Compression (2 étages)")
        self._slider(outer, "c1_thr", "Nivelage — seuil", -40, 0, 1, " dB")
        self._slider(outer, "c1_ratio", "Nivelage — ratio", 1, 10, 0.5, " : 1")
        self._slider(outer, "c1_att", "Nivelage — attaque", 1, 50, 1, " ms")
        self._slider(outer, "c1_rel", "Nivelage — relâchement", 20, 500, 10, " ms")
        self._slider(outer, "c1_makeup", "Nivelage — gain", 0, 12, 0.5, " dB")
        self._slider(outer, "c2_thr", "Crêtes — seuil", -30, 0, 1, " dB")
        self._slider(outer, "c2_ratio", "Crêtes — ratio", 1, 20, 0.5, " : 1")
        self._slider(outer, "c2_makeup", "Crêtes — gain", 0, 12, 0.5, " dB")
        outer.pack_start(Gtk.Separator(), False, False, 0)

        self._check(outer, "limiter", "Limiteur")
        self._slider(outer, "l_thr", "Seuil", -12, 0, 0.5, " dB")

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        outer.pack_start(row, False, False, 0)
        b1 = Gtk.Button(label="Défaut")
        b1.connect("clicked", self.on_default)
        row.pack_start(b1, True, True, 0)
        b2 = Gtk.Button(label="Appliquer")
        b2.connect("clicked", self.on_apply)
        row.pack_start(b2, True, True, 0)

        self.status = Gtk.Label(label="Prêt")
        self.status.set_xalign(0)
        self.status.set_line_wrap(True)
        outer.pack_start(self.status, False, False, 0)

    def _title(self, text):
        lbl = Gtk.Label()
        lbl.set_markup(f"<b>{text}</b>")
        lbl.set_xalign(0)
        return lbl

    def _check(self, parent, key, label):
        w = Gtk.CheckButton(label=label)
        w.set_active(self.s[key])
        parent.pack_start(w, False, False, 0)
        self._w[key] = w

    def _slider(self, parent, key, label, lo, hi, step, unit):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        parent.pack_start(box, False, False, 0)
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        box.pack_start(header, False, False, 0)
        lab = Gtk.Label(label=label)
        lab.set_xalign(0)
        header.pack_start(lab, True, True, 0)
        val = Gtk.Label()
        val.set_xalign(1)
        header.pack_start(val, False, False, 0)
        adj = Gtk.Adjustment(value=self.s[key], lower=lo, upper=hi, step_increment=step, page_increment=step * 5)
        scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj)
        scale.set_hexpand(True)

        def fmt(sc):
            v = sc.get_value()
            val.set_text(f"{int(v)}{unit}" if step >= 1 else f"{v:.1f}{unit}")

        scale.connect("value-changed", fmt)
        fmt(scale)
        box.pack_start(scale, False, False, 0)
        self._w[key] = scale

    def gather(self):
        for key, w in self._w.items():
            if isinstance(w, Gtk.CheckButton):
                self.s[key] = w.get_active()
            else:
                self.s[key] = w.get_value()
        if self.combo.get_active_id():
            self.s["input"] = self.combo.get_active_id()

    def on_default(self, _b):
        for key, v in DEFAULTS.items():
            if key == "input":
                resolve_input(self.s, self._sources)
                if self.s["input"]:
                    self.combo.set_active_id(self.s["input"])
                continue
            w = self._w.get(key)
            if isinstance(w, Gtk.CheckButton):
                w.set_active(v)
            elif w is not None:
                w.set_value(v)
        self.status.set_text("Valeurs par défaut chargées (pense à Appliquer)")

    def on_apply(self, _b):
        self.gather()
        try:
            write_conf(self.s)
        except Exception as e:
            self.status.set_text(f"Erreur écriture : {e}")
            return
        self.status.set_text("Application… rechargement de PipeWire")
        GLib.timeout_add(100, self._restart)

    def _restart(self):
        try:
            subprocess.run(["systemctl", "--user", "restart", "pipewire.service"],
                           capture_output=True, text=True, timeout=15)
            self.status.set_text("Appliqué. Le micro « Micro Traité » est rechargé.")
        except Exception as e:
            self.status.set_text(f"Échec du rechargement : {e}")
        return False


def main_cli():
    s = load_state()
    resolve_input(s)
    path = write_conf(s)
    print(f"Configuration écrite : {path}")
    if not s.get("input"):
        print("Aucun micro détecté : lance l'interface pour choisir l'entrée.")


def main():
    if "--write-conf" in sys.argv:
        main_cli()
        return
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__)
        return
    win = MicroTraiteApp()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
